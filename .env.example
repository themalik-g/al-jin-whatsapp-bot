# .env — Al-Jin local settings (lines starting with # are comments)
#
# Your own WhatsApp number (country code + number, digits only), e.g. 923001234567.
# Leave it empty to be asked in the terminal when you first start the bot.
WRAITH_PHONE=
WRAITH_BRANCH=main
UV_THREADPOOL_SIZE=2

# How long the terminal waits for you to type a number before falling back to
# WRAITH_PHONE (milliseconds). Only used when WRAITH_PHONE is filled in.
WRAITH_PROMPT_TIMEOUT_MS=20000

# ── Downloads (optional) ──
# Maximum size of one download in MB. Can also be changed live with  .dlcap 1gb
# WRAITH_MAX_DOWNLOAD_MB=500
# Videos bigger than this are sent as a document instead of a video (MB).
# WRAITH_VIDEO_AS_DOC_MB=64

# ── Owner / developer access ──
# Off by default. Only set this on YOUR OWN deployments if you want that number
# to always count as an owner of this bot.
# WRAITH_DEV_ACCESS=
