# .env — Al-Jin local settings (lines starting with # are comments)
#
# Your own WhatsApp number (country code + number, digits only), e.g. 923001234567.
# Leave it empty to be asked in the terminal when you first start the bot.
WRAITH_PHONE=
WRAITH_BRANCH=main
UV_THREADPOOL_SIZE=2

# How long the terminal waits for you to type a number before falling back to
# WRAITH_PHONE (milliseconds). Only used when WRAITH_PHONE is filled in.
WRAITH_PROMPT_TIMEOUT_MS=20000

# ── Downloads (optional) ──
# Maximum size of one download in MB. Can also be changed live with  .dlcap 1gb
# WRAITH_MAX_DOWNLOAD_MB=500
# Videos bigger than this are sent as a document instead of a video (MB).
# WRAITH_VIDEO_AS_DOC_MB=64

# ── Owner / developer access ──
# Off by default. Only set this on YOUR OWN deployments if you want that number
# to always count as an owner of this bot.
# WRAITH_DEV_ACCESS=

# ── Resource limits (optional) — normally set live with  .cpulimit / .ramlimit ──
# CPU cap in cores ("0.30"), as a percentage ("30%") or "auto" (90% of the server's CPU quota).
# AL_JIN_CPU_LIMIT=0.30
# RAM ceiling in MB. Add AL_JIN_RAM_RESTART=1 to restart the bot if it stays over for 20 s.
# AL_JIN_RAM_LIMIT_MB=512
# AL_JIN_RAM_RESTART=0

# ── Poll reply mode / menu (optional) ──
# How long a poll stays usable before it is deleted (ms).
# AL_JIN_POLL_TTL_MS=60000
# Real post id in your channel, only if the "forwarded from channel" label ever misbehaves.
# AL_JIN_CHANNEL_MSG_ID=
# Verified JID used for the menu's blue-tick status quote.
# WRAITH_FAKE_QUOTE_JID=

# Speech-to-text model on Groq (default: whisper-large-v3, falls back to whisper-large-v3-turbo)
# GROQ_STT_MODEL=whisper-large-v3
